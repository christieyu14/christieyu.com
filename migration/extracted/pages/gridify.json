    {
      "index": 10,
      "type": "text",
      "moduleId": null,
      "blocks": [
        {
          "type": "paragraph",
          "text": "For this phase, I iterated with CEO Adhitya Jayasinghe daily to solve existing painpoints in the REC purchasing process. What popular filters can be combined for a \"one-touch\" preset? What is the financial literacy of purchasers in the sustainability departments of big companies?",
          "links": []
        }
      ],
      "links": []
