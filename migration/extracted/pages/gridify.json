    {
      "index": 4,
      "type": "text",
      "moduleId": null,
      "blocks": [
        {
          "type": "paragraph",
          "text": "As the sole designer from day one, I defined and executed the branding strategy and led product design in Figma, driving the visual and strategic direction of both the brand and product.",
          "links": []
        },
        {
          "type": "paragraph",
          "text": "The landing page (below) was a critical way to show investors who we are, the values we believe in, and our level of maturity.",
          "links": []
        }
      ],
      "links": []
    },
    {
      "index": 5,
      "type": "image",
      "moduleId": null,
      "image": {
