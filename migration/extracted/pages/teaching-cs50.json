      "index": 1,
      "type": "text",
      "moduleId": null,
      "blocks": [
        {
          "type": "paragraph",
          "text": "During the fall semester of my sophomore year, I had a blast teaching CS50 to Yale students. Not only did I get to teach material from one of my favorite classes at Yale, I also met some of the coolest people in the CS department.",
          "links": []
        }
      ],
      "links": []
    },
