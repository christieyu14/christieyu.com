        "alt": "",
        "width": 1043,
        "height": null,
        "caption": null
      }
    },
    {
      "index": 13,
      "type": "text",
      "moduleId": null,
      "blocks": [
        {
          "type": "paragraph",
          "text": "I don’t think I’ll ever forget that email. My students have inspired me so much, and I’m so glad I decided to join CS50 staff this semester.",
          "links": []
        }
      ],
      "links": []
    },
